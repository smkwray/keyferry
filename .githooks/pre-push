#!/usr/bin/env bash
set -euo pipefail

# Only public branches/tags may leave this checkout; inspect the exact pushed objects.
cd "$(git rev-parse --show-toplevel)"
reject() { printf 'pre-push: REJECT — %s\n' "$1" >&2; exit 1; }
python_runner=''
for candidate in python python3; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    python_runner="$candidate"
    break
  fi
done
[[ -n "$python_runner" ]] || reject 'Python 3.10 or newer is required for the privacy check.'

while true; do
  local_ref='' local_oid='' remote_ref='' remote_oid='' extra=''
  if ! IFS=' ' read -r local_ref local_oid remote_ref remote_oid extra; then
    [[ -z "$local_ref$local_oid$remote_ref$remote_oid$extra" ]] || reject 'Incomplete push input.'
    break
  fi
  [[ -n "$local_ref" && -n "$remote_ref" && -z "$extra" ]] || reject 'Malformed push input.'
  [[ "$local_oid" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ &&
     "$remote_oid" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ &&
     ${#local_oid} == ${#remote_oid} ]] || reject 'Malformed push object hash.'
  case "$remote_ref" in
    refs/heads/*|refs/tags/*) ;;
    *) reject 'Only branch and tag destination namespaces may be published.' ;;
  esac
  git check-ref-format "$remote_ref" >/dev/null 2>&1 || reject 'Malformed destination ref.'
  [[ "$local_oid" =~ ^0+$ ]] && continue
  "$python_runner" scripts/check_public_tree.py --require-private-registry --history \
    --history-ref "$local_oid" --publication-name "$remote_ref" || reject 'Privacy check failed.'
done
