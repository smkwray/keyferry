# Measured on the first owner unit: 16 MiB quad flash, 8 MiB octal AP PSRAM (ESP32-S3R8).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Handheld shell (ADR 0018): console on the USB-Serial/JTAG port Home keeps; LVGL fonts used by
# the shell; LVGL allocations through malloc so large ones can live in PSRAM.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
# USB Drive (ADR 0018 rule 4): the handheld serves one image file as mass storage. 4 KiB class
# buffer (internal RAM, also present while Keyferry runs); constant-time seeks inside images.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_FATFS_USE_FASTSEEK=y
# Messages: one CDC-ACM serial port (full speed, so 64-byte packets and small FIFOs).
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=256
CONFIG_TINYUSB_CDC_TX_BUFSIZE=256
CONFIG_TINYUSB_CDC_EP_BUFSIZE=64
