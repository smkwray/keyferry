{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyferry.invalid/schema/recipe-v1.schema.json",
  "title": "Keyferry Recipe v1",
  "$comment": "Host-only saved sequences and routines; recipe-v1.md. Strict JSON, 65536 bytes, unique keys, no null, depth <= 8. Exactly one of actions or steps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name"
  ],
  "properties": {
    "schema": {
      "const": "keyferry.recipe.v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "not": {"pattern": "^(con|prn|aux|nul|com[0-9]|lpt[0-9])$"},
      "$comment": "Equals the library file stem <name>.json."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "$comment": "Author-assigned counter; never a content hash."
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "parameters": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/parameter"}
    },
    "timing": {
      "$ref": "input-sequence-v1.schema.json#/$defs/keyboard_timing"
    },
    "start_within_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000,
      "default": 5000
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/action"}
    },
    "target_os": {
      "type": "string",
      "enum": ["macos", "windows", "linux", "any"]
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "verified": {
      "oneOf": [{"const": false}, {"type": "object", "additionalProperties": false, "required": ["date", "os_version", "success_count"], "properties": {"date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "os_version": {"type": "string", "minLength": 1, "maxLength": 200}, "success_count": {"type": "integer", "minimum": 1, "maximum": 4294967295}}}]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/routine_step"}
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}, "type": {"type": "string", "enum": ["text", "integer", "secure"]}, "max_chars": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256}, "description": {"type": "string", "maxLength": 200}, "pattern": {"type": "string", "maxLength": 256}, "minimum": {"type": "integer", "minimum": -127, "maximum": 10000}, "maximum": {"type": "integer", "minimum": -127, "maximum": 10000}, "optional": {"type": "boolean", "default": false}}
    },
    "text_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "text"}, "value": {"type": "string", "minLength": 1, "maxLength": 4096}, "param": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}, "timing": {"$ref": "input-sequence-v1.schema.json#/$defs/keyboard_timing"}},
      "oneOf": [{"required": ["value"]}, {"required": ["param"]}]
    },
    "non_repeat_action": {
      "oneOf": [{"$ref": "#/$defs/text_action"}, {"$ref": "input-sequence-v1.schema.json#/$defs/tap_action"}, {"$ref": "input-sequence-v1.schema.json#/$defs/chord_action"}, {"$ref": "input-sequence-v1.schema.json#/$defs/ordered_chord_action"}, {"$ref": "input-sequence-v1.schema.json#/$defs/wait_action"}, {"$ref": "input-sequence-v1.schema.json#/$defs/move_relative_action"}, {"$ref": "input-sequence-v1.schema.json#/$defs/click_action"}, {"$ref": "input-sequence-v1.schema.json#/$defs/double_click_action"}]
    },
    "repeat_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count", "actions"],
      "properties": {"type": {"const": "repeat"}, "count": {"type": "integer", "minimum": 1, "maximum": 1000}, "actions": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/non_repeat_action"}}}
    },
    "action": {
      "oneOf": [{"$ref": "#/$defs/non_repeat_action"}, {"$ref": "#/$defs/repeat_action"}]
    },
    "routine_input_step": {
      "oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "keys"], "properties": {"type": {"const": "key"}, "keys": {"type": "array", "minItems": 1, "maxItems": 14, "items": {"type": "string", "minLength": 1, "maxLength": 64}}}}, {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "type_text"}, "text": {"type": "string", "minLength": 1, "maxLength": 4096}}}, {"type": "object", "additionalProperties": false, "required": ["type", "ms"], "properties": {"type": {"const": "wait"}, "ms": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 10000}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}}}, {"type": "object", "additionalProperties": false, "required": ["type", "x", "y"], "properties": {"type": {"const": "move"}, "x": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "y": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}}}, {"type": "object", "additionalProperties": false, "required": ["type", "x", "y"], "properties": {"type": {"const": "click"}, "x": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "y": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "button": {"type": "string", "enum": ["left", "right", "middle"]}, "double": {"type": "boolean"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "x", "y", "dx", "dy"], "properties": {"type": {"const": "scroll"}, "x": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "y": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "dx": {"oneOf": [{"type": "integer", "minimum": -127, "maximum": 127}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "dy": {"oneOf": [{"type": "integer", "minimum": -127, "maximum": 127}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}}}, {"type": "object", "additionalProperties": false, "required": ["type", "from_x", "from_y", "to_x", "to_y"], "properties": {"type": {"const": "drag"}, "from_x": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "from_y": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "to_x": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "to_y": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1279}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "button": {"type": "string", "enum": ["left", "right", "middle"]}}}]
    },
    "routine_step": {
      "oneOf": [{"$ref": "#/$defs/routine_input_step"}, {"type": "object", "additionalProperties": false, "required": ["type", "count", "steps"], "properties": {"type": {"const": "repeat"}, "count": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 1000}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "delay_ms": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 10000}, {"type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,31}\\}$"}]}, "steps": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/routine_input_step"}}}}, {"type": "object", "additionalProperties": false, "required": ["type", "timeout_ms"], "properties": {"type": {"const": "wait_for_change"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "region": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 1279}, "y": {"type": "integer", "minimum": 0, "maximum": 1279}, "width": {"type": "integer", "minimum": 1, "maximum": 1280}, "height": {"type": "integer", "minimum": 1, "maximum": 1280}}}, "on_fail": {"const": "stop", "default": "stop"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "timeout_ms"], "properties": {"type": {"const": "wait_for_stable"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "region": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 1279}, "y": {"type": "integer", "minimum": 0, "maximum": 1279}, "width": {"type": "integer", "minimum": 1, "maximum": 1280}, "height": {"type": "integer", "minimum": 1, "maximum": 1280}}}, "on_fail": {"const": "stop", "default": "stop"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "query", "timeout_ms"], "properties": {"type": {"const": "expect_text"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "region": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 1279}, "y": {"type": "integer", "minimum": 0, "maximum": 1279}, "width": {"type": "integer", "minimum": 1, "maximum": 1280}, "height": {"type": "integer", "minimum": 1, "maximum": 1280}}}, "on_fail": {"const": "stop", "default": "stop"}, "query": {"type": "string", "maxLength": 256}, "optional": {"type": "boolean"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "query", "timeout_ms"], "properties": {"type": {"const": "click_text"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "region": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 1279}, "y": {"type": "integer", "minimum": 0, "maximum": 1279}, "width": {"type": "integer", "minimum": 1, "maximum": 1280}, "height": {"type": "integer", "minimum": 1, "maximum": 1280}}}, "on_fail": {"const": "stop", "default": "stop"}, "query": {"type": "string", "minLength": 1, "maxLength": 256}, "button": {"type": "string", "enum": ["left", "right", "middle"]}, "double": {"type": "boolean"}}}, {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "secure_text"}, "param": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"}}}]
    }
  },
  "oneOf": [
    {
      "required": ["actions"],
      "not": {"required": ["steps"]}
    },
    {
      "required": ["steps", "target_os"],
      "not": {"required": ["actions"]}
    }
  ]
}
