{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyferry.invalid/schema/recipe-v1.schema.json",
  "title": "Keyferry Recipe v1",
  "$comment": "Host-only saved input plan; see recipe-v1.md. At most 65,536 bytes, unique keys, no null values. Every declared parameter is used and every param reference is declared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "actions"],
  "properties": {
    "schema": {"const": "keyferry.recipe.v1"},
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "not": {"pattern": "^(con|prn|aux|nul|com[0-9]|lpt[0-9])$"},
      "$comment": "Equals the library file stem <name>.json."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "$comment": "Author-assigned counter; never a content hash."
    },
    "description": {"type": "string", "maxLength": 200},
    "parameters": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/parameter"}
    },
    "timing": {"$ref": "input-sequence-v1.schema.json#/$defs/keyboard_timing"},
    "start_within_ms": {"type": "integer", "minimum": 1, "maximum": 5000, "default": 5000},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "type": {"const": "text"},
        "max_chars": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256}
      }
    },
    "text_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "text"},
        "value": {"type": "string", "minLength": 1, "maxLength": 4096},
        "param": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "timing": {"$ref": "input-sequence-v1.schema.json#/$defs/keyboard_timing"}
      },
      "oneOf": [{"required": ["value"]}, {"required": ["param"]}]
    },
    "non_repeat_action": {
      "oneOf": [
        {"$ref": "#/$defs/text_action"},
        {"$ref": "input-sequence-v1.schema.json#/$defs/tap_action"},
        {"$ref": "input-sequence-v1.schema.json#/$defs/chord_action"},
        {"$ref": "input-sequence-v1.schema.json#/$defs/ordered_chord_action"},
        {"$ref": "input-sequence-v1.schema.json#/$defs/wait_action"},
        {"$ref": "input-sequence-v1.schema.json#/$defs/move_relative_action"},
        {"$ref": "input-sequence-v1.schema.json#/$defs/click_action"},
        {"$ref": "input-sequence-v1.schema.json#/$defs/double_click_action"}
      ]
    },
    "repeat_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count", "actions"],
      "properties": {
        "type": {"const": "repeat"},
        "count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/non_repeat_action"}
        }
      }
    },
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/non_repeat_action"},
        {"$ref": "#/$defs/repeat_action"}
      ]
    }
  }
}
